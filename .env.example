# 이 서비스 전용 PostgreSQL 접속 주소 (DB 이름: exchangerate_dev)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# 한국수출입은행 Open API 인증키. 없으면 FX_ENABLED=false 로 두세요.
EXIM_API_KEY=

# 환율 배치(fx_daily) 활성화 스위치. 기본 false — 인증키 발급 전 매일 실패 알림이
# 나는 것을 막는다. 비활성이면 SKIPPED 로 로그하고 종료코드 0. 키 발급 후 true 로.
FX_ENABLED=false
